{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minority-prophet.invalid/interop/memory-evidence-profile-v0.1/schema.json",
  "title": "Optional Memory Evidence Interoperability Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "proposition", "claims", "search", "verifiers", "binding", "lifecycle", "conclusion"],
  "properties": {
    "profile": {"const": "memory-evidence-profile-v0.1"},
    "proposition": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "source", "derived_from", "claim_digest", "root_authentication"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {},
          "source": {"type": "string", "minLength": 1},
          "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "claim_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "root_authentication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "issuer", "key_id", "method"],
            "properties": {
              "status": {"enum": ["authenticated", "declared", "unverifiable"]},
              "issuer": {"type": ["string", "null"]},
              "key_id": {"type": ["string", "null"]},
              "method": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "coverage", "queried", "total_known"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "coverage": {"enum": ["complete", "partial", "unknown"]},
        "queried": {"type": "integer", "minimum": 0},
        "total_known": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "controller", "controller_basis"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "controller": {"type": "string", "minLength": 1},
          "controller_basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition_digest", "memory_object_digest", "request_digest", "action_digest"],
      "properties": {
        "proposition_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "memory_object_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "request_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "action_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "expires_at", "nonce", "revocation_status"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 16},
        "revocation_status": {"enum": ["active", "revoked", "unknown"]}
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "strength", "uncertainty", "method", "input_claims"],
      "properties": {
        "kind": {"enum": ["support", "contradict", "absence", "inconclusive"]},
        "strength": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "input_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
