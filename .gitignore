# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
results/*.json
# Canonical records must be reproducible from a clean clone: the manifests
# and every artifact they bind are tracked. Excluding them made
# tests/test_canonical_records.py pass only on machines that already had
# the untracked files (formal/COUNTEREXAMPLES.md CE-13).
!results/*.manifest.json
!results/los-inspired-v0.1-seed-20260803.json
!results/resolved-weather-v0.1.json

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/build/
*.egg-info/
/.wrangler/
/outputs/
/work/
/artifacts/
