{
  "max_clock_skew": 60,
  "max_pop_window": 60,
  "max_token_lifetime": 300,
  "max_status_age": 3600,
  "max_chain_length": 3,
  "predicates": [
    "eq",
    "in",
    "max",
    "min",
    "window",
    "sum_max",
    "cosign_above"
  ],
  "types": {
    "payment_initiation": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "type",
          "actions",
          "locations",
          "instructedAmount",
          "creditorAccount"
        ],
        "properties": {
          "type": {
            "const": "payment_initiation"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructedAmount": {
            "type": "object",
            "required": [
              "currency",
              "amount"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "additionalProperties": false
          },
          "creditorAccount": {
            "type": "object",
            "required": [
              "iban"
            ],
            "properties": {
              "iban": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "remittanceInformation": {
            "type": "string"
          }
        }
      },
      "admitted_members": [
        "instructedAmount",
        "creditorAccount",
        "remittanceInformation"
      ],
      "member_meanings": {
        "instructedAmount": "Currency and decimal amount of the payment to be initiated.",
        "creditorAccount": "Account of the payee, identified by IBAN.",
        "remittanceInformation": "Free text passed to the payee; it has no effect on the amount or the payee."
      }
    }
  },
  "eat_profiles": [],
  "frameworks": {
    "https://tf.example/finance": {
      "algs": [
        "EdDSA"
      ],
      "party_schemes": [
        "urn:example:pairwise",
        "urn:example:reg",
        "urn:example:workload"
      ],
      "max_lifetime": {
        "mandate+jwt": 2592000,
        "authority+jwt": 31536000,
        "wit+jwt": 86400,
        "eat+jwt": 3600,
        "agent-exposure+jwt": 300,
        "sum_max_period": 2592000
      },
      "status_required": [],
      "authority_frameworks": [
        "https://tf.example/finance"
      ]
    }
  }
}
